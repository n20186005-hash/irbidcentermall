---
import { type Locale } from "../i18n";

interface Props {
  locale: Locale;
  footer: {
    tagline: string;
    copyright: string;
    disclaimer: string;
    quick: { label: string; value: string }[];
    links: { href: string; label: string }[];
  };
}
const { locale, footer } = Astro.props as Props;
const year = new Date().getFullYear();
const dirLabel = locale === "ar" ? "معلومات سريعة" : "Quick info";
const linksLabel = locale === "ar" ? "روابط" : "Links";
---
<footer class="mt-20 border-t border-white/10 bg-ink-900">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2">
        <img src="/favicon.svg" alt="" class="h-8 w-8" />
        <span class="text-lg font-bold text-gold-400"
          >{locale === "ar" ? "سيتي سنتر إربد" : "Irbid City Center"}</span
        >
      </div>
      <p class="mt-4 text-sm leading-7 text-metal-400">{footer.tagline}</p>
      <p class="mt-3 text-xs leading-6 text-metal-400">
        {locale === "ar"
          ? "حقوق الصور: جميع الصور المعروضة في هذا الموقع تعود ملكيتها وحقوق نشرها إلى المصوّرين الأصليين وأصحاب الحقوق."
          : "Image rights: all images shown on this site belong to their original photographers and rights holders."}
      </p>
    </div>
    <div>
      <h3 class="text-sm font-bold text-white">{dirLabel}</h3>
      <ul class="mt-4 space-y-2 text-sm text-metal-400">
        {
          footer.quick.map((q) => (
            <li>
              {q.label}: {q.value}
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-bold text-white">{linksLabel}</h3>
      <ul class="mt-4 space-y-2 text-sm text-metal-400">
        {
          footer.links.map((l) => (
            <li>
              <a class="hover:text-gold-400" href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 px-4 py-6">
    <p class="mx-auto max-w-6xl text-center text-xs leading-6 text-metal-400">
      {footer.disclaimer}
    </p>
    <p class="mx-auto mt-3 max-w-6xl text-center text-xs text-metal-400">
      © {year} {footer.copyright.replace("© 2026 ", "")}
    </p>
  </div>
</footer>
