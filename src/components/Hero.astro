---
import { Image } from "astro:assets";
import heroImg from "../assets/images/irbid-city-center-main.jpg";
---
<section class="relative overflow-hidden">
  <Image
    src={heroImg}
    alt="سيتي سنتر إربد (Irbid City Centre) — المنظر الرئيسي في مدينة إربد، الأردن"
    widths={[640, 1024, 1600, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div
    class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/70 to-ink-950/40"
  >
  </div>
  <div
    class="relative mx-auto flex min-h-[88vh] max-w-6xl flex-col justify-end px-4 py-16"
  >
    <p class="mb-3 text-sm font-bold tracking-widest text-gold-400">
      إربد · شمال الأردن
    </p>
    <h1 class="text-4xl font-extrabold text-white sm:text-6xl">
      سيتي سنتر إربد (إربد)
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-metal-200">
      مركز تسوق وترفيه حضري يضم أكثر من 250 علامة تجارية ومطاعم ومساحات
      للترفيه العائلي، ويُعد من أبرز المعالم التجارية في مدينة إربد.
    </p>
    <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <span class="text-metal-200">📍 Jd Mall, Nathan Road 235, Irbid</span>
      <span class="text-metal-200">🕒 يومياً 08:00 – 00:00</span>
      <span class="text-gold-400">⭐ 4.2 / 5 (16,817 تقييم)</span>
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="#visit"
        class="rounded-full bg-gold-500 px-6 py-3 font-bold text-ink-950 transition hover:bg-gold-400"
        >الموقع على الخريطة</a
      >
      <a
        href="#visit-info"
        class="rounded-full border border-white/25 px-6 py-3 font-bold text-white transition hover:border-gold-400 hover:text-gold-400"
        >معلومات الزيارة</a
      >
    </div>
  </div>
</section>
