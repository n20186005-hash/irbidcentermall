---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import HomeContent from "../../components/HomeContent.astro";
import { content, localeMeta, hreflangAlternates, type Locale } from "../../i18n";
import { buildJsonLd } from "../../lib/schema";

const locale: Locale = "en";
const c = content[locale];
const meta = localeMeta[locale];
const jsonLd = buildJsonLd(locale, c.faq);
---
<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  canonical="/en/"
  lang={meta.htmlLang}
  dir={meta.dir}
  ogLocale={meta.ogLocale}
  ogLocaleAlternate="ar_JO"
  hreflangs={hreflangAlternates(locale)}
>
  <Fragment slot="head">
    {
      jsonLd.map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
  </Fragment>
  <Header locale={locale} nav={c.nav} />
  <HomeContent locale={locale} />
  <Footer locale={locale} footer={c.footer} />
</BaseLayout>
