---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HomeContent from "../components/HomeContent.astro";
import { content, localeMeta, hreflangAlternates, type Locale } from "../i18n";
import { buildJsonLd } from "../lib/schema";

const locale: Locale = "ar";
const c = content[locale];
const meta = localeMeta[locale];
const jsonLd = buildJsonLd(locale, c.faq);
---
<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  canonical="/"
  lang={meta.htmlLang}
  dir={meta.dir}
  ogLocale={meta.ogLocale}
  ogLocaleAlternate="en_US"
  hreflangs={hreflangAlternates(locale)}
>
  <Fragment slot="head">
    {
      jsonLd.map((data) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
  </Fragment>
  <Header locale={locale} nav={c.nav} />
  <HomeContent locale={locale} />
  <Footer locale={locale} footer={c.footer} />
</BaseLayout>
