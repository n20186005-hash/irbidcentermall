---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import interiorImg from "../assets/images/irbid-city-center-interior.jpg";
import shoppingImg from "../assets/images/irbid-city-center-shopping.jpg";
import diningImg from "../assets/images/irbid-city-center-food-court.jpg";
import entranceImg from "../assets/images/irbid-city-center-entrance.jpg";
import { Image } from "astro:assets";

const title = "سيتي سنتر إربد (إربد) | دليل الزيارة والموقع والتسوق";
const description =
  "دليل شامل لسيتي سنتر إربد (Irbid City Centre) في مدينة إربد، محافظة إربد، الأردن: الموقع على الخريطة، ساعات العمل، التسوق والمطاعم والترفيه، مواقف السيارات، خطط زيارة للعائلات والمعالم القريبة.";
const SITE = "https://irbidcentermall.com";
const ATTRACTION_FULL = "سيتي سنتر إربد";
const ATTRACTION_ALT = "Irbid City Centre";
const CITY = "إربد";
const REGION = "محافظة إربد";
const COUNTRY = "الأردن";
const POSTAL_CODE = "21110";
const MAPS_EMBED =
  "https://www.google.com/maps?q=Irbid%20City%20Centre%2C%20Irbid%2C%20Jordan&hl=ar&output=embed";
const MAPS_LINK =
  "https://www.google.com/maps/search/?api=1&query=Irbid+City+Centre+Irbid+Jordan";
const GOVT_TOURISM = "https://www.visitjordan.com/";
const NEARBY_1 = "وسط مدينة إربد (Irbid Downtown)";
const NEARBY_2 = "جامعة اليرموك (Yarmouk University)";

const faqs = [
  {
    q: "هل الدخول إلى سيتي سنتر إربد مجاني؟",
    a: "نعم، الدخول إلى المركز التجاري مجاني بالكامل ولا توجد تذكرة دخول. الرسوم المطبقة تكون فقط على الخدمات الاختيارية مثل مواقف السيارات حسب الأنظمة المعمول بها في الموقع.",
  },
  {
    q: "ما هي ساعات العمل؟",
    a: "يعمل المركز عادة من الساعة 08:00 صباحاً حتى 00:00 منتصف الليل، وقد تختلف ساعات بعض المتاجر والمطاعم كما تتغير في الأعياد والمناسبات.",
  },
  {
    q: "هل يوجد موقف سيارات؟",
    a: "نعم، تتوفر مساحات لمواقف السيارات داخل نطاق المركز وخارجه، ويُنصح بالوصول قبل أوقات الذروة في أمسيات نهاية الأسبوع.",
  },
  {
    q: "هل يناسب المركز العائلات والأطفال؟",
    a: "نعم، يوفر المركز بيئة مناسبة للعائلات مع مساحات مخصصة للأطفال ومرافق للتنقل بالعربات، إضافة إلى خيارات متعددة للطعام تناسب الأطفال.",
  },
  {
    q: "أين يقع سيتي سنتر إربد بالتحديد؟",
    a: "يقع سيتي سنتر إربد في مدينة إربد شمال الأردن، على شارع Nathan Road (Jd Mall)، ويمكن الوصول إليه بالسيارة أو سيارات الأجرة أو وسائل النقل العام.",
  },
  {
    q: "هل سيتي سنتر إربد مجاني للزيارة؟",
    a: "نعم، يُعد سيتي سنتر إربد مساحة مفتوحة للزوار والدخول إليه مجاني على مدار العام، وتبقى الرسوم مرتبطة فقط بالخدمات الاختيارية إن وُجدت.",
  },
  {
    q: "كم يستغرق وقت الزيارة المناسب؟",
    a: "تتراوح الزيارة المعتادة بين ساعة ونصف وثلاث ساعات، ويمكن أن تمتد إلى أربع أو ست ساعات في حال الجمع بين التسوق وتناول الطعام والأنشطة الترفيهية.",
  },
  {
    q: "ما أفضل وقت لتجنب الزحام؟",
    a: "أيام الأسبوع قبل الساعة السادسة مساءً هي الأهدأ عادة، أما أمسيات نهاية الأسبوع فتكون أكثر ازدحاماً ويُفضّل فيها الوصول مبكراً.",
  },
  {
    q: "هل تتوفر خدمات قريبة مثل الصيدليات والمصارف؟",
    a: "تتوفر في نطاق المدينة والمحيط التجاري خدمات متنوعة تشمل صيدليات وأجهزة صراف آلي وفروع مصارف ومحطات وقود، دون أن يوصي هذا الدليل بجهة بعينها.",
  },
  {
    q: "ما المعالم التي يمكن زيارتها قريباً من المركز؟",
    a: "يمكن دمج الزيارة مع معالم قريبة مثل وسط مدينة إربد ومتحف دار السرايا وجامعة اليرموك، إضافة إلى مواقع أثرية في محيط المحافظة تصلح لرحلة يوم.",
  },
];

const rating = {
  "@type": "AggregateRating",
  ratingValue: "4.2",
  reviewCount: "16817",
  bestRating: "5",
};

const geo = {
  "@type": "GeoCoordinates",
  latitude: 32.5357509,
  longitude: 35.8627562,
};

const address = {
  "@type": "PostalAddress",
  streetAddress: "Jd Mall, Nathan Road 235",
  addressLocality: "Irbid",
  addressRegion: "Irbid Governorate",
  postalCode: POSTAL_CODE,
  addressCountry: "JO",
};

const ogImage = `${SITE}/irbid-city-center-main.jpg`;

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    "@id": `${SITE}/#attraction`,
    name: ATTRACTION_FULL,
    alternateName: [ATTRACTION_ALT, `${CITY} ${ATTRACTION_FULL}`],
    description,
    url: SITE,
    image: [ogImage],
    address,
    geo,
    hasMap: MAPS_LINK,
    sameAs: [MAPS_LINK, GOVT_TOURISM],
    aggregateRating: rating,
    openingHours: "Mo-Su 08:00-00:00",
    isAccessibleForFree: true,
    publicAccess: true,
  },
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    name: "سيتي سنتر إربد",
    alternateName: "Irbid City Centre",
    description,
    url: SITE,
    address,
    geo,
    aggregateRating: rating,
    openingHoursSpecification: [
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday",
        ],
        opens: "08:00",
        closes: "00:00",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${SITE}/#faq`,
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE}/#website`,
    url: SITE,
    name: `${ATTRACTION_FULL} — دليل الزيارة`,
    inLanguage: "ar",
    about: { "@id": `${SITE}/#attraction` },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${SITE}/#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: COUNTRY,
        item: `${SITE}/`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: REGION,
        item: `${SITE}/#location`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: CITY,
        item: `${SITE}/#location`,
      },
      {
        "@type": "ListItem",
        position: 4,
        name: ATTRACTION_FULL,
        item: `${SITE}/`,
      },
    ],
  },
];
---
<BaseLayout title={title} description={description} canonical="/">
  <Fragment slot="head">
    {
      jsonLd.map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
  </Fragment>
  <Header />
  <main>
    <Hero />

    <nav
      aria-label="مسار التنقل"
      class="mx-auto max-w-6xl px-4 pt-8 text-xs text-metal-400"
    >
      <ol class="flex flex-wrap items-center gap-2">
        <li><a class="hover:text-gold-400" href="/">الأردن</a></li>
        <li aria-hidden="true">›</li>
        <li><a class="hover:text-gold-400" href="#location">محافظة إربد</a></li>
        <li aria-hidden="true">›</li>
        <li><span class="text-metal-200">مدينة إربد</span></li>
        <li aria-hidden="true">›</li>
        <li>
          <span class="text-gold-400">سيتي سنتر إربد (Irbid City Centre)</span>
        </li>
      </ol>
    </nav>

    <section id="about" class="mx-auto max-w-6xl px-4 py-16">
      <p class="text-sm font-bold tracking-widest text-gold-400">نظرة عامة</p>
      <h2 class="mt-2 text-3xl font-extrabold text-white">
        عن سيتي سنتر إربد (Irbid City Centre)
      </h2>
      <div class="mt-6 grid gap-8 lg:grid-cols-3">
        <div class="lg:col-span-2 space-y-4 text-metal-200">
          <p class="leading-8">
            مرحباً بكم في <strong class="text-white">سيتي سنتر إربد</strong>،
            المعروف أيضاً باسم
            <strong class="text-white">Irbid City Centre</strong>، وهو وجهة
            تجارية وترفيهية تقع في قلب مدينة
            <strong class="text-white">إربد</strong>، محافظة إربد، الأردن. يقدّم
            هذا الدليل معلومات عملية للزوار تشمل الموقع والوصول وساعات العمل
            والمرافق والخطط المقترحة للزيارة والمعالم المحيطة.
          </p>
          <p class="leading-8">
            يُعد سيتي سنتر إربد واحداً من أبرز المراكز التجارية في شمال الأردن،
            ويقع على شارع Nathan Road في مدينة إربد. يجمع المركز بين التسوق
            والتناول والترفيه العائلي في مساحة داخلية واسعة، ما يجعله وجهة يومية
            لسكان المدينة والمناطق المجاورة.
          </p>
          <p class="leading-8">
            تبلغ المساحة التجارية للمركز نحو 87,000 متر مربع، ويضم أكثر من 250
            علامة تجارية محلية ودولية موزعة على متاجر الأزياء والإلكترونيات
            والمستلزمات المنزلية، إلى جانب منطقة مطاعم ومقاهٍ ومساحات ترفيه
            مخصصة للأطفال. هذا التنوع يجعل الزيارة مناسبة لقضاء عدة ساعات دون
            الحاجة إلى مغادرة المبنى.
          </p>
          <p class="leading-8">
            يقع المركز ضمن نطاق حضري نشط في إربد، ويتميز بقربه من الجامعات
            والمؤسسات والمناطق السكنية، وهو ما يمنحه حضوراً يومياً على مدار
            الأسبوع. كما يعمل يومياً من الساعة 08:00 صباحاً حتى 00:00 منتصف
            الليل، مع احتمال تغيّر ساعات بعض المتاجر في الأعياد والمناسبات.
          </p>
        </div>
        <Image
          src={interiorImg}
          alt="مساحة داخلية واسعة في سيتي سنتر إربد مع إضاءة طبيعية ومسار للمتسوقين"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 33vw, 100vw"
          loading="lazy"
          class="h-full w-full rounded-2xl object-cover"
        />
      </div>
      <dl class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {
          [
            ["87,000 م²", "مساحة تجارية"],
            ["+250", "علامة تجارية"],
            ["08:00 – 00:00", "ساعات العمل"],
            ["4.2 / 5", "تقييم الزوار"],
          ].map(([value, label]) => (
            <div class="rounded-2xl border border-white/10 bg-ink-900 p-5">
              <dt class="text-xs text-metal-400">{label}</dt>
              <dd class="mt-2 text-xl font-extrabold text-gold-400">{value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="shopping" class="border-y border-white/10 bg-ink-900/60">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <p class="text-sm font-bold tracking-widest text-gold-400">
          تجربة التسوق
        </p>
        <h2 class="mt-2 text-3xl font-extrabold text-white">
          متاجر متنوعة تحت سقف واحد
        </h2>
        <p class="mt-4 max-w-3xl leading-8 text-metal-200">
          يضم المركز مزيجاً من المتاجر المحلية والعلامات التجارية الدولية، موزعة
          بحسب الفئة لتسهيل التنقل بينها. ويمكن للزائر إنجاز مشتريات العائلة
          اليومية والملابس والمستلزمات المنزلية في زيارة واحدة.
        </p>
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {
            [
              ["متاجر العلامات التجارية", "وحدات لماركات عالمية وإقليمية معروفة"],
              ["الأزياء والملابس", "ملابس رجالية ونسائية وأطفال وأحذية وحقائب"],
              ["المستلزمات المنزلية", "أدوات منزلية ومطبخ ومفروشات وإلكترونيات"],
              ["مشتريات العائلة", "سوبرماركت وصيدلية ومتاجر خدمات يومية"],
            ].map(([t, d]) => (
              <article class="rounded-2xl border border-white/10 bg-ink-900 p-6">
                <h3 class="font-bold text-white">{t}</h3>
                <p class="mt-3 text-sm leading-7 text-metal-400">{d}</p>
              </article>
            ))
          }
        </div>
        <Image
          src={shoppingImg}
          alt="مسار المتسوقين داخل سيتي سنتر إربد أمام واجهات المتاجر"
          widths={[640, 1024, 1600]}
          sizes="(min-width: 1024px) 80vw, 100vw"
          loading="lazy"
          class="mt-10 h-72 w-full rounded-2xl object-cover sm:h-96"
        />
      </div>
    </section>

    <section id="dining" class="mx-auto max-w-6xl px-4 py-16">
      <p class="text-sm font-bold tracking-widest text-gold-400">المطاعم</p>
      <h2 class="mt-2 text-3xl font-extrabold text-white">
        تجربة طعام داخل المركز وحوله
      </h2>
      <div class="mt-6 grid gap-8 lg:grid-cols-3">
        <div class="lg:col-span-2 space-y-4 leading-8 text-metal-200">
          <p>
            تتوزع مناطق الطعام في المركز بين صالات مشتركة تتجمع فيها عدة منافذ
            للوجبات السريعة، ومقاهٍ هادئة مناسبة للاجتماعات أو الاستراحة، إضافة
            إلى مطاعم بجلسات عائلية. ويتركز النشاط عادة في فترة الغداء والمساء.
          </p>
          <p>
            أما محيط المركز في إربد فيضم خيارات واسعة تمثل المطبخ الأردني
            والشرقي، ومن أشهر الأطباق المحلية التي يبحث عنها الزائر: المنسف،
            والمقلوبة، والفلافل والحمص، والكنافة كمشروب حلوى، إضافة إلى
            المشاوي والشاورما.
          </p>
          <p class="rounded-2xl border border-white/10 bg-ink-900 p-5 text-sm text-metal-400">
            ملاحظة: هذا الدليل محايد ولا يوصي بمطعم أو متجر بعينه، وننصح بالتحقق
            من التقييمات المحلية الحديثة قبل الزيارة.
          </p>
        </div>
        <Image
          src={diningImg}
          alt="منطقة المطاعم والمقاهي في سيتي سنتر إربد مع جلسات مشتركة"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 33vw, 100vw"
          loading="lazy"
          class="h-full w-full rounded-2xl object-cover"
        />
      </div>
    </section>

    <section id="entertainment" class="border-y border-white/10 bg-ink-900/60">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <p class="text-sm font-bold tracking-widest text-gold-400">
          الترفيه والعائلة
        </p>
        <h2 class="mt-2 text-3xl font-extrabold text-white">
          أنشطة للأطفال ولجميع أفراد الأسرة
        </h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {
            [
              [
                "مناطق ألعاب الأطفال",
                "مساحات داخلية آمنة للأطفال الصغار مع ألعاب مناسبة لأعمار مختلفة، وتخضع لإشراف ميداني.",
              ],
              [
                "جلسات عائلية ومساحات استراحة",
                "مقاعد ومقاهي موزعة داخل المركز تتيح للعائلات الاستراحة بين التسوق والتنقل.",
              ],
              [
                "فعاليات وعروض موسمية",
                "يقام على مدار العام عدد من الفعاليات والأنشطة الموسمية في الساحات الداخلية.",
              ],
            ].map(([t, d]) => (
              <article class="rounded-2xl border border-white/10 bg-ink-900 p-6">
                <h3 class="font-bold text-white">{t}</h3>
                <p class="mt-3 text-sm leading-7 text-metal-400">{d}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="visit-info" class="mx-auto max-w-6xl px-4 py-16">
      <p class="text-sm font-bold tracking-widest text-gold-400">
        معلومات الزيارة
      </p>
      <h2 class="mt-2 text-3xl font-extrabold text-white">
        ساعات العمل والرسوم
      </h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          [
            ["ساعات العمل", "يومياً من 08:00 صباحاً حتى 00:00 منتصف الليل"],
            ["الدخول", "دخول المركز التجاري مجاني"],
            ["الرسوم", "رسوم مواقف السيارات تُطبق حسب الأنظمة المعمول بها في الموقع"],
          ].map(([t, d]) => (
            <article class="rounded-2xl border border-white/10 bg-ink-900 p-6">
              <h3 class="font-bold text-gold-400">{t}</h3>
              <p class="mt-3 text-sm leading-7 text-metal-200">{d}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-6 text-sm leading-7 text-metal-400">
        قد تتغير ساعات بعض المتاجر والمطاعم دون إشعار، خصوصاً خلال الأعياد
        والمناسبات الرسمية. يُنصح بالتحقق من حساب الجهات الرسمية عند التخطيط
        لزيارة في أوقات غير معتادة.
      </p>
    </section>

    <section id="visit" class="border-y border-white/10 bg-ink-900/60">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <p class="text-sm font-bold tracking-widest text-gold-400">الوصول</p>
        <h2 id="location" class="mt-2 text-3xl font-extrabold text-white">
          الموقع وكيفية زيارة سيتي سنتر إربد في مدينة إربد
        </h2>
        <p class="mt-4 max-w-3xl leading-8 text-metal-200">
          يقع المركز في مدينة إربد على شارع Nathan Road (Jd Mall)، ويمكن الوصول
          إليه بسهولة بالسيارة أو سيارات الأجرة أو وسائل النقل العام.
        </p>
        <div class="mt-10 grid gap-8 lg:grid-cols-2">
          <div class="space-y-4">
            {
              [
                [
                  "بالسيارة الخاصة",
                  "الوصول عبر الطرق الرئيسية في إربد باتجاه شارع Nathan Road، مع توفر مساحات لوقوف السيارات داخل النطاق التجاري.",
                ],
                [
                  "سيارات الأجرة وتطبيقات النقل",
                  "يمكن طلب سيارة أجرة أو استخدام تطبيقات النقل الذكية، وحدد الوجهة باسم Irbid City Centre.",
                ],
                [
                  "النقل العام",
